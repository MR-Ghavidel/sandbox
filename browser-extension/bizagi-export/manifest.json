{
    "manifest_version": 3,
    "name": "Bizagi → کارکرد",
    "version": "1.3.0",
    "description": "Sends the Bizagi attendance (ورود و خروج) table and the browser's most visited sites, history and bookmarks to the app.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        },
        "default_title": "ارسال ورود و خروج به سامانه کارکرد",
        "default_popup": "popup.html"
    },
    "permissions": ["activeTab", "scripting", "storage"],
    "host_permissions": ["https://panel.suncitygroup.ir/*", "https://sandbox.local/*", "http://sandbox.local/*"],
    "optional_permissions": ["topSites", "history", "bookmarks"],
    "optional_host_permissions": ["https://*/*", "http://*/*"],
    "browser_specific_settings": {
        "gecko": {
            "id": "bizagi-export@sandbox.local",
            "strict_min_version": "128.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
